# App
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_PORT_BACKEND=8000
APP_PORT_FRONTEND=3000
VITE_BACKEND_URL=http://localhost:8000

# Database
POSTGRES_DB=tickets_app
POSTGRES_USER=tickets_user
POSTGRES_PASSWORD=tickets_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://tickets_user:tickets_password@postgres:5432/tickets_app

# Travelpayouts / Aviasales
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_BASE_URL=https://api.travelpayouts.com
TRAVELPAYOUTS_TIMEOUT_SEC=3
TRAVELPAYOUTS_DATA_BASE_URL=https://api.travelpayouts.com/data
TRAVELPAYOUTS_DATA_LANG=en

# LLM
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com
LLM_TIMEOUT_SEC=8
LLM_MAX_TOKENS=500
LLM_RETRY_COUNT=1
LLM_RETRY_BACKOFF_MS=150
LLM_SHORTLIST_LIMIT=8
