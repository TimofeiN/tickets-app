# App
APP_ENV=local
APP_PORT_BACKEND=8000
APP_PORT_FRONTEND=3000

# Database
POSTGRES_DB=tickets_app
POSTGRES_USER=tickets_user
POSTGRES_PASSWORD=tickets_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://tickets_user:tickets_password@postgres:5432/tickets_app

# Travelpayouts / Aviasales
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_MARKER=

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
